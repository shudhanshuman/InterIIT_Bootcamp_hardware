<?xml version="1.0"?>
<!--
  The Clue Chain Hunt robot. One model, two configurations:

  LEADER   (default)            diff drive + 360 deg LiDAR + RGB camera (5 deg down) + IMU
                                + ArUco tag id 49 on its back plate
  FOLLOWER (see sim.launch.py)  prefix:=follower/ topic_ns:=/follower/ lidar:=false imu:=false
                                rear_tag:=false camera_pitch:=-0.14 (8 deg UP) body:=blue
                                -> camera + wheel odometry only

  Frame tree (published by robot_state_publisher):
    base_footprint -> base_link -> {left_wheel_link, right_wheel_link,
                                    front_caster_link, rear_caster_link,
                                    lidar_link, imu_link,
                                    camera_link -> cam_optical_link}
  odom -> base_footprint is published by the Gazebo DiffDrive plugin.
-->
<robot name="hunter" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Configuration ===================== -->
  <xacro:arg name="prefix" default=""/>          <!-- Gazebo frame-id prefix, e.g. follower/ -->
  <xacro:arg name="topic_ns" default=""/>        <!-- Gazebo topic prefix, e.g. /follower/ -->
  <xacro:arg name="lidar" default="true"/>
  <xacro:arg name="imu" default="true"/>
  <xacro:arg name="rear_tag" default="true"/>
  <xacro:arg name="camera_pitch" default="0.0873"/>
  <xacro:arg name="body" default="orange"/>

  <xacro:include filename="$(find clue_hunt_description)/urdf/inertial_macros.xacro"/>
  <xacro:include filename="$(find clue_hunt_description)/urdf/gazebo.xacro"/>

  <!-- ===================== Dimensions ===================== -->
  <xacro:property name="chassis_x" value="0.40"/>
  <xacro:property name="chassis_y" value="0.30"/>
  <xacro:property name="chassis_z" value="0.12"/>
  <xacro:property name="chassis_mass" value="3.0"/>

  <xacro:property name="wheel_radius" value="0.06"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.3"/>
  <xacro:property name="wheel_offset_y" value="0.17"/>

  <xacro:property name="caster_radius" value="0.03"/>
  <xacro:property name="caster_offset_x" value="0.15"/>

  <!-- camera tilt: positive pitch about +Y points the lens downwards -->
  <xacro:property name="camera_pitch" value="$(arg camera_pitch)"/>

  <!-- ===================== Materials ===================== -->
  <material name="hunter_orange"><color rgba="0.92 0.34 0.15 1"/></material>
  <material name="hunter_blue"><color rgba="0.29 0.42 0.70 1"/></material>
  <material name="hunter_cam"><color rgba="0.10 0.10 0.35 1"/></material>
  <material name="hunter_black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="hunter_grey"><color rgba="0.55 0.55 0.55 1"/></material>

  <!-- ===================== Base ===================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
      <material name="hunter_$(arg body)"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
    </collision>
    <xacro:inertial_box mass="${chassis_mass}" x="${chassis_x}" y="${chassis_y}" z="${chassis_z}">
      <origin xyz="0 0 0.05"/>
    </xacro:inertial_box>
  </link>

  <!-- ===================== Wheels ===================== -->
  <xacro:macro name="wheel" params="side reflect">
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${reflect * wheel_offset_y} 0" rpy="${-reflect * pi / 2} 0 0"/>
      <axis xyz="0 0 ${reflect}"/>
    </joint>
    <link name="${side}_wheel_link">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="hunter_black"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:inertial_cylinder mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}">
        <origin xyz="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>
  </xacro:macro>

  <xacro:wheel side="left" reflect="1"/>
  <xacro:wheel side="right" reflect="-1"/>

  <!-- ===================== Casters (frictionless) ===================== -->
  <xacro:macro name="caster" params="name x">
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster_link"/>
      <origin xyz="${x} 0 ${caster_radius - wheel_radius}"/>
    </joint>
    <link name="${name}_caster_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="hunter_grey"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:inertial_sphere mass="0.05" radius="${caster_radius}">
        <origin xyz="0 0 0"/>
      </xacro:inertial_sphere>
    </link>
    <gazebo reference="${name}_caster_link">
      <mu1>0.001</mu1>
      <mu2>0.001</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster name="front" x="${caster_offset_x}"/>
  <xacro:caster name="rear" x="${-caster_offset_x}"/>

  <!-- ===================== LiDAR ===================== -->
  <xacro:if value="$(arg lidar)">
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.135" rpy="0 0 0"/>
  </joint>
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="hunter_black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.1" radius="0.04" length="0.05">
      <origin xyz="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>
  </xacro:if>

  <!-- ===================== Camera ===================== -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.19 0 0.09" rpy="0 ${camera_pitch} 0"/>
  </joint>
  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.06 0.03"/></geometry>
      <material name="hunter_cam"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.06 0.03"/></geometry>
    </collision>
    <xacro:inertial_box mass="0.05" x="0.02" y="0.06" z="0.03">
      <origin xyz="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- Optical frame: z forward, x right, y down (what OpenCV expects) -->
  <joint name="cam_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="cam_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
  </joint>
  <link name="cam_optical_link"/>

  <!-- ===================== IMU ===================== -->
  <xacro:if value="$(arg imu)">
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>
  </xacro:if>

  <!-- ===================== Rear ArUco tag (leader only) =====================
       Plate 0.16 m, marker id 49 (DICT_4X4_50) 0.12 m, centre 0.30 m above the floor,
       facing backwards. It floats above the LiDAR scan plane (0.195 m) on purpose,
       so it never shows up in the leader's own scan.
       tag_link: +X out of the printed face (points backwards from the robot). -->
  <xacro:if value="$(arg rear_tag)">
  <joint name="tag_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tag_link"/>
    <origin xyz="-0.21 0 0.24" rpy="0 0 ${pi}"/>
  </joint>
  <link name="tag_link">
    <visual>
      <geometry><mesh filename="file://$(find clue_hunt_description)/meshes/leader_tag.obj"/></geometry>
    </visual>
    <visual>
      <origin xyz="-0.005 0 0"/>
      <geometry><box size="0.008 0.17 0.17"/></geometry>
      <material name="hunter_black"/>
    </visual>
  </link>
  </xacro:if>

  <!-- Sensors and plugins live in gazebo.xacro -->
  <xacro:hunter_gazebo/>

</robot>
